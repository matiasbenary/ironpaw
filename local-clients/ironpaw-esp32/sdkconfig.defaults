# WiFi + HTTP client need more than the default 3.5 KB main stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16000
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
# 8 MB octal PSRAM (ESP32-S3R8): a 10 s recording takes 320 KB, plus another 430 KB as base64.
# Allocations under 128 KB (the framebuffer, which goes out over DMA) still go to internal RAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=131072
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# TF card: long file names
CONFIG_FATFS_LFN_HEAP=y
