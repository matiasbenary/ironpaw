              "null"
            ]
          },
          "image_mime_type": {
            "default": null,
            "description": "MIME type for image_base64. Defaults to image/png.",
            "type": [
              "string",
              "null"
            ]
          },
          "image_url": {
            "default": null,
            "description": "Optional public image URL to send with the message.",
            "type": [
