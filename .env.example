NEAR_API_KEY=your-near-ai-api-key
BRAVE_SEARCH_API=your-brave-search-api-key
# Optional:
# NEAR_BASE_URL=https://cloud-api.near.ai
# NEAR_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Speech to text on this machine instead of NEAR AI (run.sh starts whisper-server.py when set):
# WHISPER_URL=http://127.0.0.1:8010
# Fixed local client token (min 32 chars) for devices like the ESP32; random per boot if unset.
# Generate one with: openssl rand -hex 32
# IRONPAW_CLIENT_TOKEN=
# Listen on the LAN so the ESP32 can reach Ironpaw:
# IRONPAW_ADDR=0.0.0.0:<port>
# Text to speech for voice clients (POST /client/speech) with a local Piper voice.
# Install: uv tool install piper-tts; voices: https://huggingface.co/rhasspy/piper-voices
# IRONPAW_PIPER_MODEL=/path/to/en_US-lessac-medium.onnx
# IRONPAW_PIPER=piper
# ESP32 voice board: its own token (at least 32 characters, only acts as client esp32).
# IRONPAW_DEVICE_TOKEN=
# Google Calendar meetings ring on the ESP32 5 minutes before they start. In Calendar:
# Settings > your calendar > Integrate calendar > Secret address in iCal format.
# IRONPAW_CALENDAR_ICS=
