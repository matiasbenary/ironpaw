{
  "name": "email",
  "display_name": "Email",
  "description": "Read Gmail and Outlook through OAuth or use configured IMAP and SMTP servers.",
  "config_before_secrets": true,
  "setup_handler": "imap_discovery",
  "secrets": [
    {
      "name": "EMAIL_PASSWORD",
      "prompt": "Paste your email password or app password.",
      "when": { "path": "/email/provider", "equals": "imap" }
    }
  ],
  "config": [
    {
      "path": "/email/username",
      "prompt": "What is your email address? Ironpaw will detect the provider and mail settings.",
      "type": "email",
      "autoconfigure": { "action": "discover", "rerun_on_keep": true }
    },
    {
      "path": "/email/oauth/access",
      "prompt": "How much email access should Ironpaw have?",
      "type": "string",
      "when": { "path": "/email/provider", "equals": "gmail" },
      "choices": [
        {
          "label": "Read only",
          "value": "readonly",
          "oauth": {
            "login_hint_path": "/email/username",
            "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
            "token_url": "https://oauth2.googleapis.com/token",
            "client_id": "REMOVED_GOOGLE_OAUTH_CLIENT_ID",
            "client_secret": "REMOVED_GOOGLE_OAUTH_CLIENT_SECRET",
            "redirect_host": "127.0.0.1",
            "refresh_token_handle": "EMAIL_GOOGLE_REFRESH_TOKEN",
            "scopes": ["https://www.googleapis.com/auth/gmail.readonly"],
            "extra_authorize_params": { "access_type": "offline", "prompt": "consent" }
          }
        },
        {
          "label": "Take control",
          "value": "control",
          "oauth": {
            "login_hint_path": "/email/username",
            "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
            "token_url": "https://oauth2.googleapis.com/token",
            "client_id": "REMOVED_GOOGLE_OAUTH_CLIENT_ID",
            "client_secret": "REMOVED_GOOGLE_OAUTH_CLIENT_SECRET",
            "redirect_host": "127.0.0.1",
            "refresh_token_handle": "EMAIL_GOOGLE_REFRESH_TOKEN",
            "scopes": [
              "https://www.googleapis.com/auth/gmail.modify",
              "https://www.googleapis.com/auth/gmail.send"
            ],
            "extra_authorize_params": { "access_type": "offline", "prompt": "consent" }
          }
        }
      ]
    },
    {
      "path": "/email/oauth/access",
      "prompt": "How much email access should Ironpaw have?",
      "type": "string",
      "when": { "path": "/email/provider", "equals": "outlook" },
      "choices": [
        {
          "label": "Read only",
          "value": "readonly",
          "oauth": {
            "login_hint_path": "/email/username",
            "authorize_url": "https://login.microsoftonline.com/consumers/oauth2/v2.0/authorize",
            "token_url": "https://login.microsoftonline.com/consumers/oauth2/v2.0/token",
            "client_id": "0755399f-97ab-4fb1-acdb-6371f7615d7f",
            "redirect_host": "localhost",
            "refresh_token_handle": "EMAIL_MICROSOFT_REFRESH_TOKEN",
            "scopes": ["offline_access", "https://graph.microsoft.com/Mail.Read"]
          }
        },
        {
          "label": "Take control",
          "value": "control",
          "oauth": {
            "login_hint_path": "/email/username",
            "authorize_url": "https://login.microsoftonline.com/consumers/oauth2/v2.0/authorize",
            "token_url": "https://login.microsoftonline.com/consumers/oauth2/v2.0/token",
            "client_id": "0755399f-97ab-4fb1-acdb-6371f7615d7f",
            "redirect_host": "localhost",
            "refresh_token_handle": "EMAIL_MICROSOFT_REFRESH_TOKEN",
            "scopes": [
              "offline_access",
              "https://graph.microsoft.com/Mail.ReadWrite",
              "https://graph.microsoft.com/Mail.Send"
            ]
          }
        }
      ]
    },
    {
      "path": "/email/from",
      "prompt": "Default From address for sent mail.",
      "type": "string",
      "when": { "path": "/email/provider", "equals": "imap" }
    },
    {
      "path": "/email/imap/host",
      "prompt": "IMAP server host, for example imap.fastmail.com.",
      "type": "string",
      "when": { "path": "/email/provider", "equals": "imap" }
    },
    {
      "path": "/email/imap/port",
      "prompt": "IMAP server port, usually 993.",
      "type": "number",
      "when": { "path": "/email/provider", "equals": "imap" }
    },
    {
      "path": "/email/smtp/host",
      "prompt": "SMTP server host, for example smtp.fastmail.com.",
      "type": "string",
      "when": { "path": "/email/provider", "equals": "imap" }
    },
    {
      "path": "/email/smtp/port",
      "prompt": "SMTP server port, usually 465.",
      "type": "number",
      "when": { "path": "/email/provider", "equals": "imap" }
    }
  ]
}
