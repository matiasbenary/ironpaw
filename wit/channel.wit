package warden:channel;

interface channel-host {
    http-request: func(method: string, url: string, body-json: string) -> result<string, string>;
    http-request-base64: func(method: string, url: string, body-json: string) -> result<string, string>;
    http-multipart-base64: func(method: string, url: string, fields-json: string, file-field: string, filename: string, mime-type: string, data-base64: string) -> result<string, string>;
    emit-message: func(message-json: string) -> result<_, string>;
}

world channel {
    import channel-host;

    export on-start: func(config-json: string) -> result<_, string>;
    export handle-http: func(path: string, body-json: string, config-json: string) -> result<_, string>;
    export on-outbound-event: func(event-json: string, config-json: string) -> result<bool, string>;
}
